{
  "name": "dsh-runninghub",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node bin/test.mjs",
    "test:runtime": "node bin/test.mjs --runtime",
    "test:all": "node bin/test.mjs --all",
    "test:ui": "node --test tests/dsh-runninghub-ui.test.mjs"
  },
  "files": ["index.mjs", "client.js", "lib/"],
  "description": "RunningHub 本地网关工作室：在 DSH Tavern 里异步提交图片/视频任务，预览参考素材与 LoRA",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigmalove/dsh-runninghub.git"
  },
  "homepage": "https://github.com/bigmalove/dsh-runninghub#readme",
  "bugs": {
    "url": "https://github.com/bigmalove/dsh-runninghub/issues"
  },
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["dsh-tavern-plugin"]
    }
  }
}
